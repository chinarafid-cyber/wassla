# Read directly by the Next.js app (`npm run dev` / `npm run build`).
# Points at the Postgres/Redis containers started via `docker-compose.yml`
# (see `.env.example`) — default host ports below assume those defaults.
# Copy to `.env.local` and fill in real secrets. Never commit `.env.local`.

DATABASE_URL="postgresql://wassla:CHANGE_ME@localhost:5432/wassla?schema=public"
REDIS_URL="redis://:CHANGE_ME@localhost:6379"

# Generate each with: openssl rand -base64 48
# Must be at least 32 characters, and the two values must differ.
JWT_ACCESS_SECRET="CHANGE_ME"
JWT_REFRESH_SECRET="CHANGE_ME"

# "console" logs the OTP to the server console instead of sending a real SMS —
# only valid outside production (env.ts enforces "twilio" when NODE_ENV=production).
SMS_PROVIDER="console"
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="CHANGE_ME"
# TWILIO_FROM_NUMBER="+1XXXXXXXXXX"

# Optional: bootstraps one ADMIN user on `npm run db:seed`. There is no
# self-service way to become ADMIN otherwise (no password reset, no role
# upgrade endpoint) — this is how the very first admin account is created.
# SEED_ADMIN_PHONE="+9665XXXXXXXX"
# SEED_ADMIN_NAME="Admin"

# Optional: lets Playwright (and you, locally) read a just-sent OTP code via
# GET /api/v1/auth/otp/test-code?phone=... instead of scraping server logs.
# env.ts refuses to boot with this on when NODE_ENV=production.
# E2E_TEST_MODE="true"
