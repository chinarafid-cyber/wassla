# Used by `docker-compose.yml` to provision Postgres/Redis containers and
# the optional `app`/`migrate` services. Copy to `.env` and fill in real
# secrets before running `docker compose up`.
# The Next.js app itself (running via `npm run dev`) reads `.env.local`
# instead — see `.env.local.example`.

POSTGRES_USER=wassla
POSTGRES_PASSWORD=
POSTGRES_DB=wassla
POSTGRES_PORT=5432

REDIS_PASSWORD=
REDIS_PORT=6379

APP_PORT=3000
